# Copy to .env and fill in. Never commit .env.

# OpenAI (required for match + tailor features)
OPENAI_API_KEY=sk-...
# Examples: gpt-4o-mini, gpt-4o, gpt-5.1 (use what your account supports)
OPENAI_MODEL=gpt-4o-mini

# Optional: Google Custom Search JSON API (for job discovery — see README)
GOOGLE_API_KEY=
GOOGLE_CX=
